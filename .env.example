# Frontend environment variables (Vite). Copy to `.env` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# MapTiler API key used for the Hybrid base map.
# Restrict this key to your domains in the MapTiler dashboard:
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=PAAtuckOiCsaL8MuwMIX

# Base URL of the backend API.
# Local dev:  http://localhost:5000
# Production: your deployed backend, e.g. https://trackmylocation-api.onrender.com
VITE_API_URL=http://localhost:5000

# Optional: a TURN server for 1-to-1 WebRTC calls on restrictive networks.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USER=
# VITE_TURN_CREDENTIAL=
