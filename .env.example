# Frontend environment variables (Vite). Copy to `.env` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# MapTiler API key used for the Hybrid base map.
# Restrict this key to your domains in the MapTiler dashboard:
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=PAAtuckOiCsaL8MuwMIX

# Base URL of the backend API.
#
# Optional — the app already defaults correctly:
#   • served from localhost  -> http://localhost:5000
#   • served from a real domain -> https://trackmylocationbackend.onrender.com
#
# Set this on the Render static site to override either default.
# Vite inlines it at BUILD time, so redeploy after changing it.
VITE_API_URL=http://localhost:5000
#
# Same-origin mode: use a single slash so requests stay relative. Only useful if
# something in front of the API forwards /api to it (and note: Vercel rewrites do
# NOT reliably proxy WebSocket upgrades, so Socket.IO would break). Cross-site
# deployments are handled by bearer tokens instead — no proxy needed.
# VITE_API_URL=/

# Optional: a TURN server for 1-to-1 WebRTC calls on restrictive networks.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USER=
# VITE_TURN_CREDENTIAL=
